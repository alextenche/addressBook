<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token() }}">
  <title>{% block title %}Address Book{% endblock %}</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234f46e5'/%3E%3Ctext x='16' y='22' font-size='16' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='700'%3EA%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="{{ asset('assets/app.css') }}">
  <script src="{{ asset('assets/app.js') }}" type="module"></script>
</head>
<body>
  <header class="site-header">
    <div class="container site-header__inner">
      <a class="brand" href="/">
        <span class="brand__mark" aria-hidden="true">A</span>
        <span>Address Book</span>
      </a>
      {% block header_actions %}{% endblock %}
    </div>
  </header>

  <main class="container">
    {% block content %}{% endblock %}
  </main>

  <div class="toast" role="status" aria-live="polite" hidden></div>
</body>
</html>
